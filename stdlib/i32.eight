intrinsic_type i32;

instance Add<i32, i32, i32> {
  intrinsic_fn add(a: i32, b: i32) -> i32;
}

instance Sub<i32, i32, i32> {
  intrinsic_fn sub(a: i32, b: i32) -> i32;
}

instance Mul<i32, i32, i32> {
  intrinsic_fn mul(a: i32, b: i32) -> i32;
}

instance Div<i32, i32, i32> {
  intrinsic_fn div(a: i32, b: i32) -> i32;
}

instance Rem<i32, i32, i32> {
  intrinsic_fn rem(a: i32, b: i32) -> i32;
}

instance Eq<i32, i32> {
  intrinsic_fn eq(a: i32, b: i32) -> bool;
  intrinsic_fn neq(a: i32, b: i32) -> bool;
}

instance Ord<i32, i32> {
  intrinsic_fn lt(a: i32, b: i32) -> bool;
  intrinsic_fn gt(a: i32, b: i32) -> bool;
  intrinsic_fn le(a: i32, b: i32) -> bool;
  intrinsic_fn ge(a: i32, b: i32) -> bool;
}

instance Neg<i32, i32> {
  intrinsic_fn neg(a: i32) -> i32;
}
