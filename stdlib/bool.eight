intrinsic_type bool;

instance And<bool, bool> {
  intrinsic_fn and(a: bool, b: bool) -> bool;
}
instance Or<bool, bool> {
  intrinsic_fn or(a: bool, b: bool) -> bool;
}

instance Eq<bool, bool> {
  intrinsic_fn eq(a: bool, b: bool) -> bool;
  intrinsic_fn neq(a: bool, b: bool) -> bool;
}

instance Not<bool, bool> {
  intrinsic_fn not(a: bool) -> bool;
}
