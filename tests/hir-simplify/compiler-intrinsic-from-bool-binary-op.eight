// RUN: not %eightc --emit-hir --emit-query hir.fn.test_bool_eq_binop --emit-query hir.fn.test_bool_log_binop --terminator=hir %s 2>&1 | FileCheck %s

trait Eq<A, B> {
  fn eq(a: A, b: B) -> bool;
  fn neq(a: A, b: B) -> bool;
}

instance Eq<bool, bool> {
  intrinsic_fn eq(a: bool, b: bool) -> bool;
  intrinsic_fn neq(a: bool, b: bool) -> bool;
}

fn test_bool_eq_binop() {
// CHECK-LABEL: fn test_bool_eq_binop
  let binop_bool_eq = true == true;
  let binop_bool_neq = true != false;

// CHECK-NEXT: let binop_bool_eq: bool = [[EXPAND:\(+]]@@builtin_bool_eq
// CHECK-NEXT: let binop_bool_neq: bool = [[EXPAND:\(+]]@@builtin_bool_neq
}

trait And<A, B> { fn and(a: A, b: B) -> bool; }
trait Or<A, B> { fn or(a: A, b: B) -> bool; }
instance And<bool, bool> { intrinsic_fn and(a: bool, b: bool) -> bool; }
instance Or<bool, bool> { intrinsic_fn or(a: bool, b: bool) -> bool; }

fn test_bool_log_binop() {
// CHECK-LABEL: fn test_bool_log_binop
  let binop_bool_and = true && true;
  let binop_bool_or = true || false;

// CHECK-NEXT: let binop_bool_and: bool = [[EXPAND:\(+]]@@builtin_bool_and
// CHECK-NEXT: let binop_bool_or: bool = [[EXPAND:\(+]]@@builtin_bool_or
}

