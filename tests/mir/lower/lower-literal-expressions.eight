// RUN: %eightc --emit-mir --emit-query mir.fn.test_i32 --emit-query mir.fn.test_bool %s | %fc %s

fn test_i32() {
// CHECK-LABEL: mir_function test_i32
  let k = 123;
// CHECK-NEXT: entry:
// CHECK-NEXT: %0 = mem.alloca i32
// CHECK-NEXT: store i32 123, ptr %0
}

fn test_bool() {
// CHECK-LABEL: mir_function test_bool
  let k = true;
// CHECK-NEXT: entry:
// CHECK-NEXT: %0 = mem.alloca bool
// CHECK-NEXT: store bool true, ptr %0
}
