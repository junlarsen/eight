// RUN: not %eightc --emit-mir --emit-query mir.fn.test_i32 --emit-query mir.fn.test_bool --terminator=mir %s 2>&1 | FileCheck %s

fn test_i32() {
// CHECK-LABEL: mir_function test_i32
  let k = 123;
// CHECK: mem.store i32 123, ptr %0
}

fn test_bool() {
// CHECK-LABEL: mir_function test_bool
  let k = true;
// CHECK: mem.store bool true, ptr %0
}
