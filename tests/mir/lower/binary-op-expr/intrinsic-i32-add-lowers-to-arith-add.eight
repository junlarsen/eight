// RUN: %not %eightc --emit-mir --emit-query mir.fn.test --terminator=mir %s 2>&1 | %fc %s

trait Add<A, B, R> {
  fn add(a: A, b: B) -> R;
}

instance Add<i32, i32, i32> {
  intrinsic_fn add(a: i32, b: i32) -> i32;
}

fn test() {
// CHECK-LABEL: mir_function test
  let k = 123 + 456;
// CHECK: arith.add i32 i32 123, i32 456
}
