// RUN: not %eightc --emit-mir --emit-query mir.fn.test --terminator=mir %s 2>&1 | FileCheck %s

trait Mul<A, B, R> {
  fn mul(a: A, b: B) -> R;
}

instance Mul<i32, i32, i32> {
  intrinsic_fn mul(a: i32, b: i32) -> i32;
}

fn test() {
// CHECK-LABEL: mir_function test
  let k = 123 * 456;
// CHECK: arith.mul i32 i32 123, i32 456
}