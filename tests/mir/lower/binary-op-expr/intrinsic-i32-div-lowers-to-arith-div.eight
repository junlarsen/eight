// RUN: %eightc --emit-mir --emit-query mir.fn.test %s | %fc %s

trait Div<A, B, R> {
  fn div(a: A, b: B) -> R;
}

instance Div<i32, i32, i32> {
  intrinsic_fn div(a: i32, b: i32) -> i32;
}

fn test() {
// CHECK-LABEL: mir_function test
  let k = 123 / 456;
// CHECK: arith.div i32 i32 123, i32 456
}