// RUN: %not %eightc --emit-hir --terminator=hir --emit-query hir.fn.test %s 2>&1 | %fc %s

struct Node {
  value: i32,
  left: *Node,
  right: *Node,
}

fn test(node: Node) -> i32 {
// CHECK-LABEL: test
  let complex = (*(node.left)).right;
// CHECK-NEXT: let complex: *Node
  return (*complex).value;
}
