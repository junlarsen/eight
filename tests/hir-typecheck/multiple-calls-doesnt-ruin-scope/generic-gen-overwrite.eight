// RUN: not %eightc --emit-hir --terminator=hir --emit-query hir.fn.test %s 2>&1 | FileCheck %s

intrinsic_fn spawn<T>() -> T;
intrinsic_fn generic_with_gen<T, U>(x: T, y: U) -> U;

fn test<T, U>(x: T) -> T {
// CHECK-LABEL: test<
// CHECK: [[TYPE_VAR_T:\?[0-9]+]], [[TYPE_VAR_U:\?[0-9]+]]
  let z = generic_with_gen(1, true);
  let v: T = x;
// CHECK: let v: [[TYPE_VAR_T]]
}
